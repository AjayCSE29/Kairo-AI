# Kairo server
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATA_DIR=./data

# OpenAI-compatible API base for profiles routed to OpenAI (usually ends in /v1).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_JSON_MODE=true
OPENAI_STREAM_USAGE=true

# JarvisLabs OpenAI-compatible API base (usually ends in /v1).
JARVISLABS_BASE_URL=
JARVISLABS_API_KEY=
JARVISLABS_JSON_MODE=true
JARVISLABS_STREAM_USAGE=true

# Web search used for every run.
TAVILY_API_KEY=

# Map each of the six Kairo profiles to a provider and a real model ID.
# Provider values: openai | jarvislabs
MODEL_OBSIDIAN_PROVIDER=jarvislabs
MODEL_OBSIDIAN_NAME=
MODEL_OPAL_PROVIDER=openai
MODEL_OPAL_NAME=
MODEL_JADE_PROVIDER=jarvislabs
MODEL_JADE_NAME=
MODEL_GARNET_PROVIDER=openai
MODEL_GARNET_NAME=
MODEL_TOPAZ_PROVIDER=jarvislabs
MODEL_TOPAZ_NAME=
MODEL_AVENTURINE_PROVIDER=openai
MODEL_AVENTURINE_NAME=

# Limits
MAX_CONCURRENT_RUNS=2
MAX_UPLOAD_BYTES=20971520
MAX_ATTACHMENTS=5
REQUEST_TIMEOUT_MS=180000
SEARCH_TIMEOUT_MS=30000
